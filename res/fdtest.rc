#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    101, "+------------------------------------+\n|      Free Drive Test (FDTest)      |\n|         v1.0 - Open Source         |\n+------------------------------------+\n"
    102, "\nCommand line usage:\n  %s X: [Y/N]\n\n  X:     Drive letter to test (test files will be written to root directory)\n  [Y/N]  Verify test data immediately after writing (default: Y)"
    103, "Enter drive letter to test (letter only, Enter to continue, Ctrl-C to exit): "
    104, "Verify test data immediately after writing? [Y/N]: "
    105, "Enter number of test loops (write + verify per loop): "
    106, "\n *** Pass %d of %d in progress ***\n\n"
    107, "\nDrive [X:] Information\n===========================================\n"
    108, "\nUnable to retrieve drive details. Please check the drive letter.\n"
    109, "Model     : "
    110, "Revision  : "
    111, "Drive Type: "
    112, "Fixed Disk"
    113, "Removable Disk"
    114, "Capacity  : "
    115, "Free Space: "
    116, "\nTest files already exist. Skipping write phase.\n"
    117, "\rTest files already exist. Proceeding directly to verification...\n\n"
    118, "\n\nError: Failed to create file %s !\n"
    119, "\n\nError: Could not write data to file %s !\n"
    120, "\rWriting   %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    121, "\rVerifying %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    122, "             Position     Cur.Speed     Avg.Speed   Remaining  Rem.Time\n"
    123, "\rData Err  %8u MB\n"
    124, "\rWritten   %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    125, "\rVerified  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n\n"
    126, "\nTest data generation complete. Verification may be performed later.\n"
    127, "\n\nError: Could not open file %s for reading!\n"
    128, "\n\nError: Could not read data from file %s!\n"
    129, "Data verification FAILED: %u MB corrupted!\n\n"
    130, "Data verification PASSED: All test data verified successfully!\n\n"
    131, "Error: Could not delete test file %s!\n\n"
    132, "\nOperation finished. Press Enter to exit..."
    133, "High-performance I/O test mode active.\n\n"
    134, "Available drive list (removable drives marked with ""*""):\n\n"
    135, "Removing temporary test data files...\n\n"
    136, "Continue to next loop if verification errors are found? [Y/N]: "
    137, "Test complete! Total %u loop(s) tested, all passed with 0 errors!\n\n"
    138, "Test complete! Total %u loop(s) tested, %u passed. Drive instability detected!\n\n"
    139, "Test complete! Total %u loop(s) tested, all failed. Media error detected!\n\n"
    140, "Test interrupted! Tested %u loop(s), error occurred on loop %u.\n\n"
    141, "\rRead Err %8u MB\n"
    142, "Data verification FAILED: %u MB corrupted (%u MB unreadable)!\n\n"
    143, "\rUser Break %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    144, "Verification aborted by user. No errors detected up to abort point.\n\n"
    146, "\rDisk Full\n\nInsufficient free space on drive. Free up space and try again.\n"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    101, "┏━━━━━━━━━━━━━━━━━┓\n┃   Free Drive Test (FDTest) v1.0 ┃\n┃   开源 USB / 存储介质可靠性测试工具 ┃\n┗━━━━━━━━━━━━━━━━━┛\n"
    102, "\n命令行用法:\n  %s X: [Y/N]\n\n  X:     待测驱动器盘符 (测试文件将写入根目录)\n  [Y/N]  写入后是否立即校验 (默认: Y)"
    103, "请输入待测驱动器盘符 (仅输入字母，按 Enter 继续，Ctrl-C 退出): "
    104, "写入测试数据后是否立即校验？[Y/N]: "
    105, "请输入测试圈数 (写入并校验一次为一圈): "
    106, "\n *** 开始第 %d 圈测试，共 %d 圈 ***\n\n"
    107, "\n驱动器 [X:] 详细信息\n===========================================\n"
    108, "\n无法获取驱动器信息，请检查盘符是否正确。\n"
    109, "设备型号："
    110, "固件版本："
    111, "设备类型："
    112, "固定磁盘"
    113, "可移动磁盘"
    114, "容量大小："
    115, "可用空间："
    116, "\n检测到目标磁盘已存在测试文件，跳过写入阶段。\n"
    117, "\r检测到目标磁盘已存在测试文件，直接进入校验阶段！\n\n"
    118, "\n\n错误：无法创建测试文件 %s ！\n"
    119, "\n\n错误：无法向文件 %s 写入数据！\n"
    120, "\r正在写入  %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    121, "\r正在校验  %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    122, "                 位置      当前速度      平均速度        余量  剩余时间\n"
    123, "\r数据出错  %8u MB\n"
    124, "\r写入完毕  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    125, "\r校验完毕  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n\n"
    126, "\n测试文件写入完毕，您可以稍后进行校验。\n"
    127, "\n\n错误：无法打开文件 %s 读取数据！\n"
    128, "\n\n错误：从文件 %s 读取数据失败！\n"
    129, "数据校验未通过，%u MB 数据损坏！\n\n"
    130, "数据校验通过，测试文件内容完全正确！\n\n"
    131, "错误：无法删除测试文件 %s ！\n\n"
    132, "\n测试完成，按 Enter 退出..."
    133, "高性能读写测试模式已激活。\n\n"
    134, "可用驱动器列表 (标有 ""*"" 的为可移动磁盘):\n\n"
    135, "正在删除临时测试数据文件...\n\n"
    136, "数据校验出错时是否仍继续下一圈测试？[Y/N]: "
    137, "测试完成！共测试 %u 圈，全部通过，未发现问题！\n\n"
    138, "测试完成！共测试 %u 圈，仅 %u 圈通过，驱动器可能不稳定！\n\n"
    139, "测试完成！共测试 %u 圈，全部未通过，驱动器存在严重问题！\n\n"
    140, "测试中断！共测试 %u 圈，在第 %u 圈出现错误。\n\n"
    141, "\r读取失败  %8u MB\n"
    142, "数据校验未通过，%u MB 数据损坏 (其中 %u MB 无法读取)！\n\n"
    143, "\r用户打断  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    144, "用户终止校验，已测试部分未发现问题。\n\n"
    146, "\r磁盘空间不足\n\n没有足够的空间写入测试文件，请清理空间后重试。\n"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL
STRINGTABLE
BEGIN
    101, "┏━━━━━━━━━━━━━━━━━┓\n┃   Free Drive Test (FDTest) v1.0 ┃\n┃   開源 USB / 儲存介質可靠性測試工具 ┃\n┗━━━━━━━━━━━━━━━━━┛\n"
    102, "\n命令行用法:\n  %s X: [Y/N]\n\n  X:     待測磁碟機號 (測試檔案將寫入根目錄)\n  [Y/N]  寫入後是否立即校驗 (預設: Y)"
    103, "請輸入待測磁碟機號 (僅輸入字母，按 Enter 繼續，Ctrl-C 退出): "
    104, "寫入測試資料後是否立即校驗？[Y/N]: "
    105, "請輸入測試圈數 (寫入並校驗一次為一圈): "
    106, "\n *** 開始第 %d 圈測試，共 %d 圈 ***\n\n"
    107, "\n磁碟機 [X:] 詳細資訊\n===========================================\n"
    108, "\n無法獲取磁碟機資訊，請檢查磁碟機號是否正確。\n"
    109, "裝置型號："
    110, "韌體版本："
    111, "裝置類型："
    112, "固定磁碟"
    113, "抽取式磁碟"
    114, "容量大小："
    115, "可用空間："
    116, "\n檢測到目標磁碟已存在測試檔案，跳過寫入階段。\n"
    117, "\r檢測到目標磁碟已存在測試檔案，直接進入校驗階段！\n\n"
    118, "\n\n錯誤：無法建立測試檔案 %s ！\n"
    119, "\n\n錯誤：無法向檔案 %s 寫入資料！\n"
    120, "\r寫入中    %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    121, "\r校驗中    %8u MB %8.2f MB/s %8.2f MB/s %8u MB  %02d:%02d:%02d    "
    122, "                 位置      當前速度      平均速度        餘量  剩餘時間\n"
    123, "\r資料錯誤  %8u MB\n"
    124, "\r寫入完畢  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    125, "\r校驗完畢  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n\n"
    126, "\n測試檔案寫入完畢，您可以稍後進行校驗。\n"
    127, "\n\n錯誤：無法開啟檔案 %s 讀取資料！\n"
    128, "\n\n錯誤：從檔案 %s 讀取資料失敗！\n"
    129, "資料校驗未通過，%u MB 資料損壞！\n\n"
    130, "資料校驗通過，測試檔案內容完全正確！\n\n"
    131, "錯誤：無法移除測試檔案 %s ！\n\n"
    132, "\n測試完成，按 Enter 退出..."
    133, "高效率讀寫測試模式已啟用。\n\n"
    134, "可用磁碟機列表 (標有 ""*"" 的為抽取式磁碟):\n\n"
    135, "正在移除暫存測試資料檔案...\n\n"
    136, "資料校驗出錯時是否仍繼續下一圈測試？[Y/N]: "
    137, "測試完成！共測試 %u 圈，全部通過，未發現問題！\n\n"
    138, "測試完成！共測試 %u 圈，僅 %u 圈通過，磁碟機可能不穩定！\n\n"
    139, "測試完成！共測試 %u 圈，全部未通過，磁碟機存在嚴重問題！\n\n"
    140, "測試中斷！共測試 %u 圈，在第 %u 圈出現錯誤。\n\n"
    141, "\r讀檔失敗  %8u MB\n"
    142, "資料校驗未通過，%u MB 資料損壞 (其中 %u MB 無法讀取)！\n\n"
    143, "\r用戶打斷  %8u MB        - MB/s %8.2f MB/s        - MB  --:--:--    \n"
    144, "用戶終止校驗，已測試部分未發現問題。\n\n"
    146, "\r磁碟空間不足\n\n沒有足夠的空間寫入測試檔案，請清理空間後重試。\n"
END
